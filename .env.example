# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
EXTRACTION_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Neo4j (e.g. a free Neo4j AuraDB instance)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Tuning (optional — sensible defaults are already in config.py)
ENTITY_SIMILARITY_THRESHOLD=0.93
ENTITY_SUBSTRING_MIN_LEN=3
WEIGHT_SIMILARITY=0.55
WEIGHT_IMPORTANCE=0.35
WEIGHT_RECENCY=0.10
IMPORTANCE_LANDMARK_FLOOR=0.75
RECENCY_HALF_LIFE_DAYS=365
DEFAULT_SPEAKER=default
